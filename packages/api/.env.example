# База данных (PostgreSQL)
# Локально используется docker-compose с портом 5433 (порт 5432 занят системным Postgres)
DATABASE_URL=postgresql://money:money@localhost:5433/budget_app?schema=public

# Порт API
PORT=3000

# Токен Telegram-бота (обязателен в production — без него вход невозможен)
BOT_TOKEN=

# Секрет подписи сессионных токенов. В production обязателен, минимум 16 символов.
AUTH_SECRET=

# DEV_MODE=true разрешён ТОЛЬКО для локальной разработки.
# В production запуск с DEV_MODE=true блокируется.
DEV_MODE=true

# Список разрешённых источников CORS через запятую ("https://app.example.com")
# Если пусто: в dev разрешён http://localhost:5173, в production заголовки CORS не отдаются.
CORS_ORIGINS=

# NODE_ENV=production для боевого запуска
NODE_ENV=development